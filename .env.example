# Copy to .env.local (git-ignored) and adjust. EXPO_PUBLIC_* values are inlined at build time.

# Origins of the two back-ends (no trailing /api). Defaults point to the local mock (npm run mock:api).
# Android emulator: run `adb reverse tcp:4001 tcp:4001 && adb reverse tcp:4002 tcp:4002` so localhost works.
EXPO_PUBLIC_PARCEL_API_URL=http://localhost:4001
EXPO_PUBLIC_ROOM_API_URL=http://localhost:4002

# "Chấm công" tile opens THACO Paytime; falls back to the store pages when the app is not installed.
EXPO_PUBLIC_PAYTIME_URL=thacopaytime://
EXPO_PUBLIC_PAYTIME_IOS_STORE_URL=https://apps.apple.com/vn/search?term=THACO%20Paytime
EXPO_PUBLIC_PAYTIME_ANDROID_STORE_URL=https://play.google.com/store/search?q=THACO%20Paytime&c=apps

# Optional: internal IT hotline used by "Liên hệ IT nội bộ" on the login screen.
EXPO_PUBLIC_IT_SUPPORT_PHONE=
