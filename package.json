{
  "name": "thaco-hrm-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~55.0.17",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "clsx": "^2.1.1",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.52.0",
    "nativewind": "^4.2.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:prod": "expo start --no-dev --minify",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "env:pull": "eas env:pull --environment development --path .env --non-interactive",
    "env:pull:preview": "eas env:pull --environment preview --path .env --non-interactive",
    "env:pull:prod": "eas env:pull --environment production --path .env --non-interactive",
    "env:push": "eas env:push --path .env",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e": "maestro test .maestro",
    "doctor": "npx expo-doctor",
    "native:clean": "expo prebuild --clean",
    "build:apk:dev": "eas build --local --platform android --profile development --output build/thaco-hrm-dev.apk",
    "build:apk": "eas build --local --platform android --profile preview --output build/thaco-hrm-preview.apk",
    "build:aab": "eas build --local --platform android --profile production --output build/thaco-hrm.aab",
    "build:apk:cloud": "eas build --platform android --profile preview"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
