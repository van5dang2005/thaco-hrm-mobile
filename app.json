{
  "expo": {
    "name": "THACO HRM",
    "slug": "thaco-hrm-mobile",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thacohrm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.com.thaco.hrm",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "THACO HRM dùng camera để chụp ảnh bưu phẩm khi tiếp nhận.",
        "NSPhotoLibraryUsageDescription": "THACO HRM cần truy cập thư viện ảnh để đính kèm ảnh bưu phẩm.",
        "NSFaceIDUsageDescription": "THACO HRM dùng Face ID để đăng nhập nhanh.",
        "LSApplicationQueriesSchemes": [
          "thacopaytime"
        ]
      }
    },
    "android": {
      "package": "vn.com.thaco.hrm",
      "adaptiveIcon": {
        "backgroundColor": "#00539B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00539B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0B1420",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "THACO HRM dùng camera để chụp ảnh bưu phẩm khi tiếp nhận.",
          "photosPermission": "THACO HRM cần truy cập thư viện ảnh để đính kèm ảnh bưu phẩm."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "THACO HRM dùng Face ID để đăng nhập nhanh."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
